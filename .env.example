# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for client-side Maps JavaScript SDK (@vis.gl/react-google-maps).
# Restrict this key in Google Cloud Console to HTTP referrers and Maps JavaScript API / Places API (New).
VITE_GOOGLE_MAPS_API_KEY=""

# GOOGLE_MAPS_SERVER_API_KEY: Server-side Google Maps Platform API Key for Geocoding API and Routes API v2 proxy routes.
GOOGLE_MAPS_SERVER_API_KEY=""

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Credentials for server-side payment order creation and HMAC-SHA256 signature verification.
RAZORPAY_KEY_ID="rzp_test_yourfashionstore"
RAZORPAY_KEY_SECRET="your_razorpay_hmac_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Notification Provider Keys (Optional external integrations for Email / SMS / WhatsApp)
SMTP_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""
